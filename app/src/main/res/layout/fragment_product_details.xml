<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    tools:context=".fragment.ProductDetailsFragment"
    android:orientation="vertical">


<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/produktBildDetails"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginEnd="8dp"
        android:scaleType="centerCrop"/>

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="200dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/produktNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/produktname"
                android:textStyle="bold"
                android:textSize="24sp"
                android:layout_marginBottom="10dp"
                />
            <TextView
                android:id="@+id/produktZutatenText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/zutaten"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"
                />
            <TextView
                android:id="@+id/produktAllergeneText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/allergene"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>
            <TextView
                android:id="@+id/produktHerkunftText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/herkunft"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TableLayout
                    android:id="@+id/nutriTabelle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TableRow>
                        <TextView
                            android:text="@string/n_hrstoffe"
                            android:textStyle="bold"
                            android:padding="8dp"/>
                        <TextView
                            android:text="@string/menge_pro_100g"
                            android:textStyle="bold"
                            android:padding="8dp"/>
                        <TextView
                            android:text="@string/einheit"
                            android:textStyle="bold"
                            android:padding="8dp"/>
                    </TableRow>

                </TableLayout>
            </HorizontalScrollView>


        </LinearLayout>

    </ScrollView>


</LinearLayout>

    <EditText
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/productAmount"
        android:hint="@string/produktmenge"
        android:inputType="number"
        android:gravity="center"
        android:layout_marginBottom="5dp"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/produktHinzufuegen"
        android:text="@string/hinzuf_gen"
        android:layout_gravity="center"
        />

</LinearLayout>